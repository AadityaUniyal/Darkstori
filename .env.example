# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Twitter API Configuration (Optional - for sentiment analysis)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret

# Live Feed Configuration
LIVE_FEED_ENABLED=true
LIVE_FEED_UPDATE_INTERVAL=300
LIVE_FEED_RETENTION_HOURS=24

# Database Configuration - Neon PostgreSQL
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Scraping Configuration
SCRAPE_DELAY_SECONDS=2
MAX_RETRIES=3

# API Rate Limits
GOOGLE_API_DAILY_LIMIT=40000

# Backend API Configuration
SECRET_KEY=your_secret_key_here_min_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=development
DEBUG=False

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0

# Monitoring
ENABLE_METRICS=True
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Email Configuration (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL=alerts@yourdomain.com

# MLflow Configuration
MLFLOW_TRACKING_URI=postgresql+psycopg2://username:password@host:port/database?sslmode=require
MLFLOW_ARTIFACT_LOCATION=./mlruns
MLFLOW_SERVER_HOST=0.0.0.0
MLFLOW_SERVER_PORT=5000
MLFLOW_SERVER_WORKERS=1
MLFLOW_ENABLE_TRACKING=true

# Model Serving Configuration
MODEL_CACHE_TTL_SECONDS=3600
MODEL_RELOAD_CHECK_INTERVAL=60
DEFAULT_MODEL_NAME=demand_forecasting_model

# ML Monitoring Configuration
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_DRIFT_DETECTION=true
DRIFT_CHECK_FREQUENCY_DAYS=7

# Alert Configuration - Email
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=your_email@gmail.com
ALERT_SMTP_PASSWORD=your_app_password
ALERT_SMTP_TLS=true
ALERT_FROM_EMAIL=ml-alerts@yourdomain.com
ALERT_TO_EMAILS=admin@yourdomain.com,team@yourdomain.com

# Alert Configuration - Slack
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_SLACK_CHANNEL=#ml-alerts
ALERT_SLACK_USERNAME=ML Monitor Bot
ALERT_SLACK_ICON=:robot_face:
