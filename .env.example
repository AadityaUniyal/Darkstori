# Google API Keys (can use same key if one project with all APIs enabled)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_GEOCODING_API_KEY=your_geocoding_api_key_here
GOOGLE_DISTANCE_MATRIX_API_KEY=your_distance_matrix_key_here
GOOGLE_API_DAILY_LIMIT=40000

# Kaggle API (required for dataset download in kaggle_integration.py)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_API_KEY=your_kaggle_api_key

# Twitter API Configuration (Optional - for sentiment analysis)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret

# Live Feed Configuration
LIVE_FEED_ENABLED=true
LIVE_FEED_UPDATE_INTERVAL=300
LIVE_FEED_RETENTION_HOURS=24

# Database Configuration - Neon PostgreSQL
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# JWT Security (REQUIRED: change the secret in production)
JWT_SECRET_KEY=your-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Scraping Configuration
SCRAPE_DELAY_SECONDS=2
MAX_RETRIES=3

# Model Storage Configuration (choose one strategy)
# Option A: AWS S3 for model storage
AWS_S3_BUCKET=darkstori-models
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# Option B: Use local storage (models/ directory) - not recommended for production
MODEL_STORAGE_TYPE=local  # Options: local, s3, gcs

# Environment
ENVIRONMENT=development
DEBUG=False    # Set to True ONLY for local development, NEVER in production

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis Configuration (separate databases for different purposes)
REDIS_URL=redis://localhost:6379/0          # For app caching
CELERY_BROKER_URL=redis://localhost:6379/1  # For Celery task queue
CELERY_RESULT_BACKEND=redis://localhost:6379/2  # For Celery task results

# Monitoring
ENABLE_METRICS=True
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Email Configuration (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL=alerts@yourdomain.com

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000  # Client-facing URI
MLFLOW_BACKEND_STORE_URI=sqlite:///mlflow.db  # Where MLflow stores metadata (file:/// or postgresql://)
MLFLOW_ARTIFACT_LOCATION=./mlruns
MLFLOW_SERVER_HOST=0.0.0.0
MLFLOW_SERVER_PORT=5000
MLFLOW_SERVER_WORKERS=1
MLFLOW_ENABLE_TRACKING=true

# Model Serving Configuration
MODEL_CACHE_TTL_SECONDS=3600
MODEL_RELOAD_CHECK_INTERVAL=60
DEFAULT_MODEL_NAME=demand_forecasting_model

# ML Monitoring Configuration
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_DRIFT_DETECTION=true
DRIFT_CHECK_FREQUENCY_DAYS=7

# Alert Configuration - Email
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=your_email@gmail.com
ALERT_SMTP_PASSWORD=your_app_password
ALERT_SMTP_TLS=true
ALERT_FROM_EMAIL=ml-alerts@yourdomain.com
ALERT_TO_EMAILS=admin@yourdomain.com,team@yourdomain.com

# Alert Configuration - Slack
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_SLACK_CHANNEL=#ml-alerts
ALERT_SLACK_USERNAME=ML Monitor Bot
ALERT_SLACK_ICON=:robot_face:

# CI/CD Configuration
# Codecov - Code coverage reporting (get token from https://codecov.io)
CODECOV_TOKEN=your_codecov_token_here
